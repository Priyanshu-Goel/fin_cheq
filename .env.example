# --- Supabase (Postgres + pgvector) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD

# --- Anthropic (used for RAG note generation - Claude Haiku is cheapest) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional cheap fundamentals API (indianapi.in via RapidAPI) ---
# Leave blank to force the free Screener.in scraper fallback instead.
INDIAN_API_KEY=
INDIAN_API_BASE_URL=https://stock.indianapi.in

# --- App config ---
BACKTEST_YEARS_AGO=3
CORS_ALLOW_ORIGIN=http://localhost:3000
